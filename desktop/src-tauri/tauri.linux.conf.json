{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["appimage", "deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "Records your meetings and writes the notes, on this computer",
    "resources": {
      "../../build/windows/python/": null,
      "../../build/windows/backend/": null,
      "../../build/windows/ui/": null,
      "../../build/windows/bin/": null,
      "../../build/windows/VERSION": null,
      "../../build/linux/python/": "python/",
      "../../build/linux/backend/": "backend/",
      "../../build/linux/ui/": "ui/",
      "../../build/linux/bin/": "bin/",
      "../../build/linux/VERSION": "VERSION"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libpulse0"],
        "section": "sound"
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3", "pulseaudio-libs"]
      }
    }
  }
}
