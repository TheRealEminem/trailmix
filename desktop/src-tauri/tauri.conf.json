{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trailmix",
  "mainBinaryName": "Trailmix",
  "version": "0.0.0",
  "identifier": "local.trailmix.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/windows/python/": "python/",
      "../../build/windows/backend/": "backend/",
      "../../build/windows/ui/": "ui/",
      "../../build/windows/bin/": "bin/",
      "../../build/windows/VERSION": "VERSION"
    },
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
