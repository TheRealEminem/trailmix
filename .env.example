# Long random string; you'll type it once per browser. Generate one with: openssl rand -base64 32
TRAILMIX_ACCESS_TOKEN=

# Transcription: your Mac's worker over Tailscale (./trailmix worker on the Mac)...
TRAILMIX_TRANSCRIBE_URL=http://your-mac:8770/v1
TRAILMIX_TRANSCRIBE_API_KEY=same-value-as-TRAILMIX_WORKER_TOKEN-on-the-mac
# ...or a cloud API, e.g. https://api.groq.com/openai/v1 with model whisper-large-v3-turbo

# Summaries: Ollama on your Mac (start it with OLLAMA_HOST=0.0.0.0), or add cloud API keys in Settings.
OLLAMA_URL=http://your-mac:11434
