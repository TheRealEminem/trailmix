# Long random string; you'll type it once per browser. Generate one with: openssl rand -base64 32
TRAILMIX_ACCESS_TOKEN=

# Transcription happens on the server by itself (whisper.cpp). To send audio elsewhere instead, uncomment these:
# a transcription worker over Tailscale (./trailmix worker on a Mac, PC or Linux machine)...
#TRAILMIX_TRANSCRIBE_URL=http://your-computer:8770/v1
#TRAILMIX_TRANSCRIBE_API_KEY=same-value-as-TRAILMIX_WORKER_TOKEN-on-that-computer
# ...or a cloud API, e.g. https://api.groq.com/openai/v1 with TRAILMIX_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Summaries: Ollama on the server itself (the default), on another computer (start it there with
# OLLAMA_HOST=0.0.0.0, then uncomment this), or add cloud API keys in Settings.
#OLLAMA_URL=http://your-computer:11434
